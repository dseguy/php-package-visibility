#!/usr/bin/env php
<?php

declare(strict_types=1);

use PhpPackageVisibility\Cleaner\Cleaner;

$autoloadCandidates = [
    __DIR__ . '/../vendor/autoload.php',
    __DIR__ . '/../../../autoload.php',
];

foreach ($autoloadCandidates as $candidate) {
    if (is_file($candidate)) {
        require $candidate;
        break;
    }
}

function pv_clean_usage(): never
{
    fwrite(STDERR, <<<'TXT'
    Usage:
      pv-clean <path> --out=<dir>
      pv-clean <path> --in-place

    <path> may be a single .php file or a directory (scanned recursively for *.php files).
    TXT . "\n");
    exit(1);
}

$args = array_slice($_SERVER['argv'], 1);

if (count($args) < 2) {
    pv_clean_usage();
}

$path = $args[0];
$outDir = null;
$inPlace = false;

foreach (array_slice($args, 1) as $option) {
    if ($option === '--in-place') {
        $inPlace = true;
    } elseif (str_starts_with($option, '--out=')) {
        $outDir = substr($option, strlen('--out='));
    } else {
        pv_clean_usage();
    }
}

if (!$inPlace && $outDir === null) {
    pv_clean_usage();
}

if (!file_exists($path)) {
    fwrite(STDERR, "Path not found: {$path}\n");
    exit(1);
}

/** @return list<string> */
function pv_clean_collect_files(string $path): array
{
    if (is_file($path)) {
        return [$path];
    }

    $files = [];
    $iterator = new RecursiveIteratorIterator(
        new RecursiveDirectoryIterator($path, FilesystemIterator::SKIP_DOTS)
    );

    foreach ($iterator as $file) {
        assert($file instanceof SplFileInfo);
        if ($file->isFile() && $file->getExtension() === 'php') {
            $files[] = $file->getPathname();
        }
    }

    sort($files);

    return $files;
}

$cleaner = new Cleaner();
$files = pv_clean_collect_files($path);
$baseDir = is_dir($path) ? rtrim($path, '/') : dirname($path);

foreach ($files as $file) {
    $source = file_get_contents($file);
    if ($source === false) {
        fwrite(STDERR, "Could not read: {$file}\n");
        exit(1);
    }

    $cleaned = $cleaner->clean($source);

    if ($inPlace) {
        file_put_contents($file, $cleaned);
        continue;
    }

    $relative = ltrim(substr($file, strlen($baseDir)), '/');
    $destination = rtrim((string) $outDir, '/') . '/' . $relative;
    $destinationDir = dirname($destination);

    if (!is_dir($destinationDir) && !mkdir($destinationDir, 0777, true) && !is_dir($destinationDir)) {
        fwrite(STDERR, "Could not create directory: {$destinationDir}\n");
        exit(1);
    }

    file_put_contents($destination, $cleaned);
}

fwrite(STDOUT, sprintf("Cleaned %d file(s).\n", count($files)));
