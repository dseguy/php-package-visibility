#!/usr/bin/env php
<?php

declare(strict_types=1);

use PhpPackageVisibility\Checker\Checker;

$autoloadCandidates = [
    __DIR__ . '/../vendor/autoload.php',
    __DIR__ . '/../../../autoload.php',
];

foreach ($autoloadCandidates as $candidate) {
    if (is_file($candidate)) {
        require $candidate;
        break;
    }
}

function pv_check_usage(): never
{
    fwrite(STDERR, "Usage:\n  pv-check <path> [<path> ...]\n\n<path> may be a .php file or a directory (scanned recursively for *.php files).\n");
    exit(1);
}

$paths = array_slice($_SERVER['argv'], 1);

if ($paths === []) {
    pv_check_usage();
}

/** @return list<string> */
function pv_check_collect_files(string $path): array
{
    if (is_file($path)) {
        return [$path];
    }

    $files = [];
    $iterator = new RecursiveIteratorIterator(
        new RecursiveDirectoryIterator($path, FilesystemIterator::SKIP_DOTS)
    );

    foreach ($iterator as $file) {
        assert($file instanceof SplFileInfo);
        if ($file->isFile() && $file->getExtension() === 'php') {
            $files[] = $file->getPathname();
        }
    }

    return $files;
}

$files = [];
foreach ($paths as $path) {
    if (!file_exists($path)) {
        fwrite(STDERR, "Path not found: {$path}\n");
        exit(1);
    }

    array_push($files, ...pv_check_collect_files($path));
}

sort($files);

$checker = new Checker();
$violations = $checker->check($files);

if ($violations === []) {
    fwrite(STDOUT, sprintf("No visibility violations found (%d file(s) checked).\n", count($files)));
    exit(0);
}

foreach ($violations as $violation) {
    fwrite(STDOUT, $violation . "\n");
}

fwrite(STDOUT, sprintf("\n%d violation(s) found in %d file(s).\n", count($violations), count($files)));
exit(1);
