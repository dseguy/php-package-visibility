{
    "name": "dseguy/php-package-visibility",
    "description": "Namespace-scoped visibility (private/protected/public) for PHP classes, interfaces, traits, and enums.",
    "type": "library",
    "license": "MIT",
    "keywords": [
        "php",
        "namespace",
        "visibility",
        "static-analysis",
        "encapsulation",
        "package-private"
    ],
    "authors": [
        {
            "name": "Damien Seguy",
            "email": "damien@seguy.org"
        }
    ],
    "require": {
        "php": "^8.3",
        "nikic/php-parser": "^5.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.0",
        "phpstan/phpstan": "^2.0"
    },
    "autoload": {
        "psr-4": {
            "PhpPackageVisibility\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "PhpPackageVisibility\\Tests\\": "tests/"
        }
    },
    "bin": [
        "bin/pv-clean",
        "bin/pv-check"
    ],
    "scripts": {
        "test": "phpunit",
        "stan": "phpstan analyse"
    }
}
